   app.enableCors({
     origin: process.env.WEB_APP_ORIGIN ?? "http://localhost:3000",
@@ -52,6 +57,10 @@ async function bootstrap() {
   SwaggerModule.setup("api/docs", app, document);
 
   await app.listen(port);
+  // eslint-disable-next-line no-console
