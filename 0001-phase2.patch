+    `Nirka Inventory API listening on port ${port} (env: ${process.env.NODE_ENV ?? "development"}, CORS origin: ${process.env.WEB_APP_ORIGIN ?? "http://localhost:3000"})`,
+  );
 }
 
 void bootstrap();
diff --git a/backend/speech/.env.example b/backend/speech/.env.example
new file mode 100644
index 0000000..4d6982a
--- /dev/null
+++ b/backend/speech/.env.example
@@ -0,0 +1,24 @@
+# faster-whisper speech-to-text service environment variables.
+# Names copied exactly from backend/speech/app/main.py.
+
+# Railway injects PORT automatically for container start.
+PORT=5001
+
+# Whisper model size. "base" is the current default (see
+# infrastructure/start-local-speech.ps1). Larger models need more RAM —
+# check Railway plan memory before changing this.
+WHISPER_MODEL=base
+WHISPER_DEVICE=cpu
+WHISPER_COMPUTE_TYPE=int8
+
+# Directory used to cache downloaded model weights so they are not
+# re-downloaded on every deploy/restart. Point this at a Railway
+# persistent volume mount, e.g. /app/.cache/whisper-models.
+WHISPER_MODEL_CACHE=/app/.cache/whisper-models
+
+# Beam size for decoding; 1 = greedy/fastest, higher = slower but can be
+# slightly more accurate on longer or ambiguous audio.
+WHISPER_BEAM_SIZE=1
+
+# Domain-specific prompt to bias transcription toward warehouse vocabulary.
+WHISPER_INITIAL_PROMPT=Warehouse inventory. Actions: receive, ship, transfer, cycle count, damage. Items: cable, helmet, gloves, tape, box, bottle, bolt, bearing. Locations: receiving, dispatch, packing, storage one, storage two, storage three.
diff --git a/backend/speech/Dockerfile b/backend/speech/Dockerfile
new file mode 100644
index 0000000..dccfc6f
--- /dev/null
+++ b/backend/speech/Dockerfile
@@ -0,0 +1,37 @@
+# Production image for the faster-whisper speech-to-text service.
+# Build context is backend/speech/ itself (no workspace file: dependency here).
+#
+#   docker build -f backend/speech/Dockerfile backend/speech
+
+FROM python:3.12-slim AS base
+WORKDIR /app
+
+# ffmpeg is required by faster-whisper/ctranslate2's audio decoding path for
+# non-WAV uploads (webm/ogg/mp4 from the browser MediaRecorder API).
+RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
+    && rm -rf /var/lib/apt/lists/*
+
+COPY requirements.txt .
+RUN pip install --no-cache-dir -r requirements.txt
+
+COPY app ./app
+
+RUN groupadd --system nirka && useradd --system --gid nirka --home /app nirka \
+    && mkdir -p /app/.cache/whisper-models \
+    && chown -R nirka:nirka /app
+USER nirka
+
+# WHISPER_MODEL_CACHE should point at a Railway persistent volume so the
+# model is downloaded once, not on every deploy/restart.
+ENV WHISPER_MODEL_CACHE=/app/.cache/whisper-models \
+    WHISPER_MODEL=base \
+    WHISPER_DEVICE=cpu \
+    WHISPER_COMPUTE_TYPE=int8
+
+# Keep this service private on Railway (no public domain) — the API reaches
+# it over Railway's private network via SPEECH_SERVICE_URL.
+EXPOSE 5001
+
+# Railway injects PORT; uvicorn binds it directly since main.py has no
+# hardcoded port itself (only the old local .ps1 launcher did).
+CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-5001}"]
diff --git a/frontend/.env.example b/frontend/.env.example
new file mode 100644
index 0000000..efafe9a
--- /dev/null
+++ b/frontend/.env.example
@@ -0,0 +1,24 @@
+# Frontend environment variables.
+#
+# IMPORTANT: only NEXT_PUBLIC_* variables are readable by the app, and
+# vinext inlines them into the browser bundle AT BUILD TIME (not read at
+# container start). Never put secrets here — everything below is visible
+# to anyone who opens the site's JavaScript.
+#
+# Local development: all four already default to localhost in code
+# (see src/features/inventory/auth/keycloak.ts and
+# src/features/inventory/api/inventory-api.ts), so this file is only
+# required for production builds.
+
+# Public URL of the NestJS API, e.g. https://nirka-api.up.railway.app/api
+NEXT_PUBLIC_API_URL=
+
+# Public URL of Keycloak, e.g. https://nirka-keycloak.up.railway.app
+NEXT_PUBLIC_KEYCLOAK_URL=
+
+# Keycloak realm name (matches infrastructure/keycloak/nirka-inventory-realm.json)
+NEXT_PUBLIC_KEYCLOAK_REALM=nirka-inventory
+
+# Keycloak public/web client id (must be the PUBLIC client, not the API's
+# confidential client — never put a client secret in a frontend variable)
+NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nirka-inventory-web
diff --git a/frontend/Dockerfile b/frontend/Dockerfile
new file mode 100644
index 0000000..c18a25d
--- /dev/null
+++ b/frontend/Dockerfile
@@ -0,0 +1,57 @@
+# Production image for the vinext (Next.js-on-Vite) frontend.
+# Runs as a plain Node server (frontend/next.config.ts sets output: "standalone"),
+# not on Vercel or Cloudflare Workers.
+#
+# IMPORTANT: build context must be the REPOSITORY ROOT, not frontend/.
+# frontend/package.json depends on "inventory-management-workspace": "file:..",
+# so the workspace root package.json must be reachable during npm ci.
+# On Railway: set this service's "Root Directory" to the repo root, and
+# point the Dockerfile path at frontend/Dockerfile.
+#
+#   docker build -f frontend/Dockerfile .
+
+FROM node:22.13-bookworm-slim AS base
+WORKDIR /repo
+
+# --- deps ---
+FROM base AS deps
+COPY package.json ./package.json
+COPY frontend/package.json frontend/package-lock.json ./frontend/
+WORKDIR /repo/frontend
+RUN npm ci
+
+# --- build ---
+FROM base AS build
+COPY package.json ./package.json
+COPY frontend ./frontend
+COPY --from=deps /repo/frontend/node_modules ./frontend/node_modules
+WORKDIR /repo/frontend
+ENV NODE_ENV=production
+# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
+# they must be passed as build args, not just runtime env vars.
+ARG NEXT_PUBLIC_API_URL
+ARG NEXT_PUBLIC_KEYCLOAK_URL
+ARG NEXT_PUBLIC_KEYCLOAK_REALM
+ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID
+ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
+ENV NEXT_PUBLIC_KEYCLOAK_URL=${NEXT_PUBLIC_KEYCLOAK_URL}
+ENV NEXT_PUBLIC_KEYCLOAK_REALM=${NEXT_PUBLIC_KEYCLOAK_REALM}
+ENV NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=${NEXT_PUBLIC_KEYCLOAK_CLIENT_ID}
+RUN npm run build
+
+# --- runtime: only the standalone output, non-root user ---
+FROM node:22.13-bookworm-slim AS runtime
+WORKDIR /app
+ENV NODE_ENV=production
+RUN groupadd --system nirka && useradd --system --gid nirka --home /app nirka
+
+COPY --from=build /repo/frontend/dist/standalone ./
+COPY --from=build /repo/frontend/public ./public
+
+USER nirka
+
+# Railway injects PORT; vinext's standalone server reads PORT/HOST.
+ENV HOST=0.0.0.0
+EXPOSE 3000
+
+CMD ["node", "server.js"]
