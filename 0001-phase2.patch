--- /dev/null
+++ b/backend/api/.env.example
@@ -0,0 +1,55 @@
+# NestJS API environment variables.
+# Names below are copied exactly from what backend/api/src actually reads
+# (grepped from source) — do not rename these when configuring Railway.
+
+# --- Core ---
+NODE_ENV=production
+# Railway injects PORT automatically; only set this manually for local runs.
+PORT=4000
+
+# --- Database (Railway PostgreSQL plugin provides this automatically as a
+# reference variable — usually you won't set this by hand) ---
+DATABASE_URL=postgresql://user:password@host:5432/database?schema=public
+
+# --- Frontend origin, used for CORS (must exactly match the deployed
+# frontend URL, including https:// and no trailing slash) ---
+WEB_APP_ORIGIN=http://localhost:3000
+
+# --- Keycloak ---
+# Full issuer URL including realm, e.g.
+# https://nirka-keycloak.up.railway.app/realms/nirka-inventory
+KEYCLOAK_ISSUER=http://localhost:8080/realms/nirka-inventory
+# Expected audience/client id on incoming access tokens.
+KEYCLOAK_AUDIENCE=nirka-inventory-api
+# Base URL of the Keycloak server without the realm path (derived from
+# KEYCLOAK_ISSUER if omitted).
+KEYCLOAK_BASE_URL=http://localhost:8080
+# Realm name (derived from KEYCLOAK_ISSUER if omitted).
+KEYCLOAK_REALM=nirka-inventory
+# Confidential client used by the API for Keycloak Admin REST calls
+# (user activation/deactivation, user access page). This is a SECRET —
+# generate it in Keycloak, never commit the real value.
+KEYCLOAK_USER_ADMIN_CLIENT_ID=nirka-inventory-user-admin
+KEYCLOAK_USER_ADMIN_CLIENT_SECRET=
+
+# --- Speech-to-text service (Railway private networking URL) ---
+SPEECH_SERVICE_URL=http://127.0.0.1:5001
+
+# --- Ollama AI service (Railway private networking URL) ---
+OLLAMA_URL=http://127.0.0.1:11434
+OLLAMA_MODEL=qwen3:4b
+OLLAMA_KEEP_ALIVE=30m
+OLLAMA_NUM_PREDICT=256
+OLLAMA_NUM_CTX=2048
+OLLAMA_NUM_THREADS=
+
+# --- Evidence storage (must point at a Railway persistent volume mount in
+# production, e.g. /app/evidence — see backend/api/Dockerfile) ---
+EVIDENCE_STORAGE_PATH=../../.local/evidence
+
+# --- Observability (all optional; omit entirely to disable tracing) ---
+OTEL_TRACING_ENABLED=
+OTEL_TRACE_EXPORTER=
+OTEL_EXPORTER_OTLP_ENDPOINT=
+OTEL_PRISMA_INSTRUMENTATION=
+METRICS_PORT=
diff --git a/backend/api/Dockerfile b/backend/api/Dockerfile
new file mode 100644
index 0000000..7b372fb
--- /dev/null
+++ b/backend/api/Dockerfile
@@ -0,0 +1,67 @@
+# Production image for the NestJS inventory API.
+#
+# IMPORTANT: build context must be the REPOSITORY ROOT, not backend/api/.
+# backend/api/package.json depends on "inventory-management-workspace":
+# "file:../..", so the workspace root package.json must be reachable
+# during npm ci. On Railway: set this service's "Root Directory" to the
+# repo root, and point the Dockerfile path at backend/api/Dockerfile.
+#
+#   docker build -f backend/api/Dockerfile .
+
+FROM node:22.13-bookworm-slim AS base
+WORKDIR /repo
+# Prisma's query engine needs openssl at runtime on Debian.
+RUN apt-get update && apt-get install -y --no-install-recommends openssl \
+    && rm -rf /var/lib/apt/lists/*
+
+# --- deps ---
+FROM base AS deps
+COPY package.json ./package.json
+COPY backend/api/package.json backend/api/package-lock.json ./backend/api/
+WORKDIR /repo/backend/api
+RUN npm ci
+
+# --- build ---
+FROM base AS build
+COPY package.json ./package.json
+COPY backend/api ./backend/api
+COPY --from=deps /repo/backend/api/node_modules ./backend/api/node_modules
+WORKDIR /repo/backend/api
+RUN npm run db:generate
+RUN npm run build
+
+# --- prod deps only (smaller runtime image) ---
+FROM base AS prod-deps
+COPY package.json ./package.json
+COPY backend/api/package.json backend/api/package-lock.json ./backend/api/
+WORKDIR /repo/backend/api
+RUN npm ci --omit=dev
+# The Prisma client generated against devDependencies' prisma CLI must be
+# regenerated here too, since generate writes into node_modules/@prisma/client.
+COPY backend/api/prisma ./prisma
+RUN npx prisma generate
+
+# --- runtime ---
+FROM node:22.13-bookworm-slim AS runtime
+WORKDIR /app
+RUN apt-get update && apt-get install -y --no-install-recommends openssl \
+    && rm -rf /var/lib/apt/lists/*
+ENV NODE_ENV=production
+RUN groupadd --system nirka && useradd --system --gid nirka --home /app nirka
+
+COPY --from=prod-deps /repo/backend/api/node_modules ./node_modules
+COPY --from=build /repo/backend/api/dist ./dist
+COPY --from=build /repo/backend/api/prisma ./prisma
+COPY --from=build /repo/backend/api/package.json ./package.json
+
+# Evidence storage volume mount point (see EVIDENCE_STORAGE_PATH).
+RUN mkdir -p /app/evidence && chown -R nirka:nirka /app
+
+USER nirka
+
+# Railway injects PORT; main.ts reads it (defaults to 4000).
+EXPOSE 4000
+
+# Run pending migrations, then start. Uses `migrate deploy`, never
+# `migrate dev`, and never seeds or resets data automatically.
+CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main.js"]
