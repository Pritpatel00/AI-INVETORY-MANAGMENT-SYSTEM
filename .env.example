# Root workspace .env.example.
# This file documents variable names and purpose only — no real values.
# Each service (frontend, backend/api, backend/speech) also has its own
# .env.example with the variables specific to that service.
#
# For local development, copy the relevant file(s) to .env / .env.local in
# each service directory and fill in real values. Never commit filled-in
# .env files — .gitignore already excludes .env*.

NODE_ENV=development
