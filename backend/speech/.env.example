# faster-whisper speech-to-text service environment variables.
# Names copied exactly from backend/speech/app/main.py.

# Railway injects PORT automatically for container start.
PORT=5001

# Whisper model size. "base" is the current default (see
# infrastructure/start-local-speech.ps1). Larger models need more RAM —
# check Railway plan memory before changing this.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Directory used to cache downloaded model weights so they are not
# re-downloaded on every deploy/restart. Point this at a Railway
# persistent volume mount, e.g. /app/.cache/whisper-models.
WHISPER_MODEL_CACHE=/app/.cache/whisper-models

# Beam size for decoding; 1 = greedy/fastest, higher = slower but can be
# slightly more accurate on longer or ambiguous audio.
WHISPER_BEAM_SIZE=1

# Domain-specific prompt to bias transcription toward warehouse vocabulary.
WHISPER_INITIAL_PROMPT=Warehouse inventory. Actions: receive, ship, transfer, cycle count, damage. Items: cable, helmet, gloves, tape, box, bottle, bolt, bearing. Locations: receiving, dispatch, packing, storage one, storage two, storage three.
