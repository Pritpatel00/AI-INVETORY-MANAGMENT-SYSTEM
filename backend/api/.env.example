# NestJS API environment variables.
# Names below are copied exactly from what backend/api/src actually reads
# (grepped from source) — do not rename these when configuring Railway.

# --- Core ---
NODE_ENV=production
# Railway injects PORT automatically; only set this manually for local runs.
PORT=4000

# --- Database (Railway PostgreSQL plugin provides this automatically as a
# reference variable — usually you won't set this by hand) ---
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# --- Frontend origin, used for CORS (must exactly match the deployed
# frontend URL, including https:// and no trailing slash) ---
WEB_APP_ORIGIN=http://localhost:3000

# --- Local JWT migration ---
# Generate a random secret with at least 32 bytes. Never expose this through
# NEXT_PUBLIC_* frontend variables.
JWT_SECRET=
JWT_ISSUER=nirka-inventory-api
JWT_AUDIENCE=nirka-inventory-api
# The repository does not contain the deployed frontend origin; use the
# cross-site-safe mode until both production origins are verified same-site.
AUTH_COOKIE_SAMESITE=none
# Set false for local HTTP development; production must use true (or rely on
# NODE_ENV=production's secure default).
AUTH_COOKIE_SECURE=true

# --- Keycloak ---
# Full issuer URL including realm, e.g.
# https://nirka-keycloak.up.railway.app/realms/nirka-inventory
KEYCLOAK_ISSUER=http://localhost:8080/realms/nirka-inventory
# Expected audience/client id on incoming access tokens.
KEYCLOAK_AUDIENCE=nirka-inventory-api
# Base URL of the Keycloak server without the realm path (derived from
# KEYCLOAK_ISSUER if omitted).
KEYCLOAK_BASE_URL=http://localhost:8080
# Realm name (derived from KEYCLOAK_ISSUER if omitted).
KEYCLOAK_REALM=nirka-inventory
# Confidential client used by the API for Keycloak Admin REST calls
# (user activation/deactivation, user access page). This is a SECRET —
# generate it in Keycloak, never commit the real value.
KEYCLOAK_USER_ADMIN_CLIENT_ID=nirka-inventory-user-admin
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=

# --- Local Faster Whisper API ---
# The NestJS API sends multipart audio to the local service started by
# infrastructure/start-local-speech.ps1.
WHISPER_API_URL=http://127.0.0.1:5001
# POST multipart/form-data: audio file and optional language hint.
# Expected response: {text: "...", language: "en", languageProbability,
# duration, model, segments}.
# Timeout: 120 seconds, including response body; upload limit: 20 MiB.

# --- Local Ollama AI (used for inventory extraction) ---
# Ollama must be running locally with the qwen3:4b model pulled.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
# Optional; omit to let Ollama choose the CPU/GPU thread count.
OLLAMA_NUM_THREADS=

# --- Evidence storage (must point at a Railway persistent volume mount in
# production, e.g. /app/evidence — see backend/api/Dockerfile) ---
EVIDENCE_STORAGE_PATH=../../.local/evidence

# --- Observability (all optional; omit entirely to disable tracing) ---
OTEL_TRACING_ENABLED=
OTEL_TRACE_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_PRISMA_INSTRUMENTATION=
METRICS_PORT=
