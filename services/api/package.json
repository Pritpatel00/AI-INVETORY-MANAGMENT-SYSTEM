    "db:reset:test-fixtures": "tsx prisma/reset-test-fixtures.ts",
    "db:seed:samples": "tsx prisma/seed-warehouse-samples.ts",
    "db:verify:samples": "tsx prisma/verify-warehouse-samples.ts",
    "db:studio": "prisma studio",
    "rules:test": "tsx --test src/inventory/rules/inventory-rules.engine.spec.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
